# ─── Environment ──────────────────────────────────────────────────────
AEROLAKE_ENV=local
AEROLAKE_LOG_LEVEL=INFO

# ─── MinIO container (read by docker/docker-compose.yml) ───────────────
# Root credentials bootstrap the MinIO server and create the bucket.
# Do NOT use these in application code — create a service account below.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=aerolake_admin
MINIO_ROOT_PASSWORD=change_me_in_real_env
# Bucket the minio-init container creates on startup.
AEROLAKE_BUCKET=aerolake-captures

# ─── AeroLake app (read by aerolake.common.config.Settings) ────────────
# Service account credentials — generate via the MinIO console at
# http://localhost:9001 → Access Keys → Create. Never use root creds here.
AEROLAKE_S3_ENDPOINT=http://localhost:9000
AEROLAKE_S3_ACCESS_KEY=
AEROLAKE_S3_SECRET_KEY=
AEROLAKE_S3_BUCKET=aerolake-captures
AEROLAKE_S3_REGION=us-east-1

# ─── TLS (endpoints HTTPS signés par une CA interne, ex. FAST) ─────────
# La solution PROPRE : pointer vers le certificat de la CA interne.
#AEROLAKE_S3_CA_BUNDLE=/chemin/vers/ca-interne.pem
# Dépannage TEMPORAIRE uniquement (réseau interne de confiance) :
#AEROLAKE_S3_VERIFY_SSL=false
