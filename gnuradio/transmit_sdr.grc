options:
  parameters:
    author: AeroLake
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'RE-EMIT a stored AeroLake .sigmf-data capture as REAL RF, via a
      BladeRF (SoapySDR TX). This is the hardware half of "playback": the file
      is the bridge (raw cf32_le). DANGER: transmitting on GNSS/Iridium bands
      over the air is illegal and jams real receivers — use a shielded cable,
      an attenuator, a dummy load or a Faraday enclosure.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: aerolake_transmit_sdr
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: 'True'
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: AeroLake Transmit (re-emit a capture via BladeRF / SoapySDR)
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: sdr_driver
  id: variable
  parameters:
    comment: 'SoapySDR TX driver. The RTL-SDR is RX-only — TX needs a BladeRF
      (or HackRF/Pluto/LimeSDR).'
    value: '"bladerf"'
  states:
    coordinate: [184, 12]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: 'Sample rate (Hz) — MUST match the capture''s core:sample_rate
      (Iridium test = 400000).'
    value: '400000'
  states:
    coordinate: [304, 12]
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: 'TX center frequency (Hz) — match the capture''s core:frequency
      (Iridium = 1626271000).'
    value: '1626271000'
  states:
    coordinate: [424, 12]
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable
  parameters:
    comment: 'BladeRF TX gain (dB). START LOW. Into a cable/attenuator a few dB
      is plenty; never blast an antenna.'
    value: '20'
  states:
    coordinate: [536, 12]
    rotation: 0
    state: enabled
- name: tx_amplitude
  id: variable
  parameters:
    comment: 'Digital backoff (0..1) before the DAC. The stored IQ is normalised
      to ~[-1, 1]; 0.8 leaves headroom so the DAC never clips.'
    value: '0.8'
  states:
    coordinate: [664, 12]
    rotation: 0
    state: enabled
- name: capture_file
  id: variable
  parameters:
    comment: 'Local .sigmf-data file (raw cf32_le) — fetch it from MinIO with
      `aerolake-fetch --key <key> --out /tmp/capture.sigmf-data`.'
    value: '"/tmp/capture.sigmf-data"'
  states:
    coordinate: [784, 12]
    rotation: 0
    state: enabled
- name: repeat
  id: variable
  parameters:
    comment: 'Loop the file forever (True) or transmit it once (False).'
    value: 'False'
  states:
    coordinate: [928, 12]
    rotation: 0
    state: enabled
- name: start_s
  id: variable
  parameters:
    comment: 'Partial read: start offset in seconds (0 = from the beginning).'
    value: '0'
  states:
    coordinate: [1040, 12]
    rotation: 0
    state: enabled
- name: duration_s
  id: variable
  parameters:
    comment: 'Partial read: how many seconds to transmit (0 = to the end).'
    value: '0'
  states:
    coordinate: [1160, 12]
    rotation: 0
    state: enabled
- name: blocks_file_source_0
  id: blocks_file_source
  parameters:
    affinity: ''
    alias: ''
    begin_tag: pmt.PMT_NIL
    comment: 'Read the capture as complex float32 (== cf32_le). offset/length give
      partial transmit: start at start_s seconds, send duration_s seconds (0 = all).'
    file: capture_file
    length: int(duration_s * samp_rate)
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: int(start_s * samp_rate)
    repeat: repeat
    type: complex
    vlen: '1'
  states:
    coordinate: [80, 260]
    rotation: 0
    state: enabled
- name: blocks_multiply_const_vxx_0
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: 'Digital amplitude backoff before the DAC (tx_amplitude in 0..1).'
    const: tx_amplitude
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    coordinate: [360, 272]
    rotation: 0
    state: enabled
- name: soapy_custom_sink_0
  id: soapy_custom_sink
  parameters:
    affinity: ''
    alias: ''
    antenna0: '"TX"'
    bandwidth0: '0'
    center_freq0: freq
    comment: 'Any SoapySDR TX device (driver=sdr_driver, default bladerf). The SDR
      clock paces the stream — no Throttle needed (and none wanted) with real hw.'
    dc_offset0: '0'
    dev_args: ''
    driver: sdr_driver
    freq_correction0: '0'
    gain0: tx_gain
    iq_balance0: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    nchan: '1'
    samp_rate: samp_rate
    settings0: ''
    stream_args: ''
    tune_args0: ''
    type: fc32
  states:
    coordinate: [630, 252]
    rotation: 0
    state: enabled
- name: qtgui_freq_sink_x_0
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'False'
    average: '0.1'
    axislabels: 'True'
    bw: samp_rate
    comment: 'Monitor what you are actually transmitting (a tap before the SDR).'
    ctrlpanel: 'False'
    fc: freq
    fftsize: '1024'
    freqhalf: 'True'
    grid: 'False'
    gui_hint: ''
    label: Relative Gain
    label1: ''
    label10: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"Transmitted spectrum"'
    nconnections: '1'
    norm_window: 'False'
    showports: 'False'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_tag: '""'
    type: complex
    units: dB
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    wintype: window.WIN_BLACKMAN_hARRIS
    ymax: '10'
    ymin: '-140'
  states:
    coordinate: [630, 400]
    rotation: 0
    state: enabled

connections:
- [blocks_file_source_0, '0', blocks_multiply_const_vxx_0, '0']
- [blocks_multiply_const_vxx_0, '0', soapy_custom_sink_0, '0']
- [blocks_multiply_const_vxx_0, '0', qtgui_freq_sink_x_0, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
