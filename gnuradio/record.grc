options:
  parameters:
    author: AeroLake
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Record a finite IQ capture to a .sigmf-data file (synthetic source
      until a real SDR is wired in).
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: aerolake_record
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: AeroLake Record
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: 'Sample rate (Hz).'
    value: '2000000'
  states:
    coordinate: [184, 12]
    rotation: 0
    state: enabled
- name: n_samples
  id: variable
  parameters:
    comment: 'How many samples to record, then stop.'
    value: '1000000'
  states:
    coordinate: [288, 12]
    rotation: 0
    state: enabled
- name: out_file
  id: variable
  parameters:
    comment: 'Output .sigmf-data path (raw cf32_le).'
    value: '"/tmp/capture.sigmf-data"'
  states:
    coordinate: [408, 12]
    rotation: 0
    state: enabled
- name: analog_sig_source_x_0
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.1'
    comment: 'Synthetic tone at 100 kHz, -20 dBFS (stand-in for a real SDR source).'
    freq: '100000'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: complex
    waveform: analog.GR_COS_WAVE
  states:
    coordinate: [80, 196]
    rotation: 0
    state: enabled
- name: blocks_throttle_0
  id: blocks_throttle
  parameters:
    affinity: ''
    alias: ''
    comment: 'Pace generation at the sample rate, mimicking a real capture.'
    ignoretag: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: complex
    vlen: '1'
  states:
    coordinate: [350, 212]
    rotation: 0
    state: enabled
- name: blocks_head_0
  id: blocks_head
  parameters:
    affinity: ''
    alias: ''
    comment: 'Stop after n_samples — gives a finite recording.'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: n_samples
    type: complex
    vlen: '1'
  states:
    coordinate: [560, 212]
    rotation: 0
    state: enabled
- name: blocks_file_sink_0
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: 'Write raw complex float32 — directly usable as a .sigmf-data blob.'
    file: out_file
    type: complex
    unbuffered: 'False'
    vlen: '1'
  states:
    coordinate: [760, 220]
    rotation: 0
    state: enabled

connections:
- [analog_sig_source_x_0, '0', blocks_throttle_0, '0']
- [blocks_throttle_0, '0', blocks_head_0, '0']
- [blocks_head_0, '0', blocks_file_sink_0, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
