options:
  parameters:
    author: AeroLake
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Record a finite IQ capture from a REAL SDR (RTL-SDR, BladeRF, …)
      to a .sigmf-data file, via SoapySDR. Works with any SoapySDR device — set
      sdr_driver.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: aerolake_record_sdr
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: AeroLake Record (real SDR via SoapySDR)
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: sdr_driver
  id: variable
  parameters:
    comment: 'SoapySDR driver: "rtlsdr", "bladerf", "hackrf", … (one flowgraph, any SDR).'
    value: '"rtlsdr"'
  states:
    coordinate: [184, 12]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: 'Sample rate (Hz). RTL-SDR: <= ~2.4e6. BladeRF: up to 61e6 (needed for Starlink 25e6).'
    value: '2000000'
  states:
    coordinate: [304, 12]
    rotation: 0
    state: enabled
- name: freq
  id: variable
  parameters:
    comment: 'Center frequency (Hz). GNSS L1 = 1575420000, Iridium = 1626000000.'
    value: '1575420000'
  states:
    coordinate: [424, 12]
    rotation: 0
    state: enabled
- name: gain
  id: variable
  parameters:
    comment: 'Manual RX gain (dB), used when agc is False.'
    value: '40'
  states:
    coordinate: [536, 12]
    rotation: 0
    state: enabled
- name: agc
  id: variable
  parameters:
    comment: 'Automatic gain control on/off. True = let the SDR set the gain.'
    value: 'True'
  states:
    coordinate: [624, 12]
    rotation: 0
    state: enabled
- name: n_samples
  id: variable
  parameters:
    comment: 'How many samples to record, then stop (here: 1 s at samp_rate).'
    value: '2000000'
  states:
    coordinate: [728, 12]
    rotation: 0
    state: enabled
- name: out_file
  id: variable
  parameters:
    comment: 'Output .sigmf-data path (raw cf32_le).'
    value: '"/tmp/capture.sigmf-data"'
  states:
    coordinate: [848, 12]
    rotation: 0
    state: enabled
- name: soapy_custom_source_0
  id: soapy_custom_source
  parameters:
    affinity: ''
    agc0: agc
    alias: ''
    antenna0: '"RX"'
    bandwidth0: '0'
    center_freq0: freq
    comment: 'Any SoapySDR device (driver=sdr_driver). Outputs complex float32 (fc32).'
    dc_offset0: '0'
    dc_removal0: 'False'
    dev_args: ''
    driver: sdr_driver
    freq_correction0: '0'
    gain0: gain
    iq_balance0: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    nchan: '1'
    samp_rate: samp_rate
    settings0: ''
    stream_args: ''
    tune_args0: ''
    type: fc32
  states:
    coordinate: [80, 200]
    rotation: 0
    state: enabled
- name: blocks_head_0
  id: blocks_head
  parameters:
    affinity: ''
    alias: ''
    comment: 'Stop after n_samples — gives a finite recording.'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: n_samples
    type: complex
    vlen: '1'
  states:
    coordinate: [430, 212]
    rotation: 0
    state: enabled
- name: blocks_file_sink_0
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: 'Write raw complex float32 — directly usable as a .sigmf-data blob.'
    file: out_file
    type: complex
    unbuffered: 'False'
    vlen: '1'
  states:
    coordinate: [640, 220]
    rotation: 0
    state: enabled

connections:
- [soapy_custom_source_0, '0', blocks_head_0, '0']
- [blocks_head_0, '0', blocks_file_sink_0, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
